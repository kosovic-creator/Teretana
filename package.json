{
  "name": "hulk23-teretana",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "dotenv -e .env -- next dev --port 3000",
    "prebuild": "pnpm db:generate",
    "build": "dotenv -e .env -- next build",
    "start": "dotenv -e .env -- next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "auth:create-admin": "dotenv -e .env -- tsx scripts/create-admin.ts",
    "db:studio": "dotenv -e .env -- prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^10.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}