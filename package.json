{
  "name": "hulk23-teretana",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @hulk23/admin dev",
    "dev:admin": "pnpm --filter @hulk23/admin dev",
    "build": "pnpm --filter @hulk23/admin build",
    "lint": "pnpm --filter @hulk23/admin lint",
    "typecheck": "pnpm --filter @hulk23/admin typecheck",
    "db:generate": "pnpm --filter @hulk23/database generate",
    "db:push": "pnpm --filter @hulk23/database db:push",
    "db:migrate": "pnpm --filter @hulk23/database migrate",
    "auth:create-admin": "pnpm --filter @hulk23/database create-admin",
    "db:studio": "pnpm --filter @hulk23/database studio"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.2"
  }
}
